# Copy this file to .env.deploy.local and replace every placeholder locally.
# Never commit .env.deploy.local.

QUIZ_TEST_SSH_HOST=test-host.example.invalid
QUIZ_TEST_SSH_USER=deploy-user
QUIZ_TEST_SSH_KEY=C:\Users\your-name\.ssh\test-deploy-key
QUIZ_TEST_PUBLIC_URL=https://test.example.invalid
QUIZ_TEST_DATABASE=replace_with_test_database

QUIZ_PROD_SSH_HOST=prod-host.example.invalid
QUIZ_PROD_SSH_USER=deploy-user
QUIZ_PROD_SSH_KEY=C:\Users\your-name\.ssh\prod-deploy-key
QUIZ_PROD_PUBLIC_URL=https://www.example.com
QUIZ_PROD_DATABASE=replace_with_production_database

# Optional deployment report email settings.
DEPLOY_REPORT_MAIL_TRANSPORT=smtp
DEPLOY_REPORT_SMTP_HOST=smtp.example.com
DEPLOY_REPORT_SMTP_PORT=465
DEPLOY_REPORT_SMTP_USER=sender@example.com
DEPLOY_REPORT_SMTP_PASS=replace_with_smtp_authorization_code
DEPLOY_REPORT_FROM=sender@example.com
DEPLOY_REPORT_TO=recipient@example.com
