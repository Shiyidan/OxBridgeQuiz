# Runtime profile: local and test support HTTP; prod requires HTTPS cookies.
# local: direct local development; test/prod: normally one trusted Nginx proxy hop.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/quiztestdemo"
API_RUNTIME_ENV=local
API_PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Access and refresh session
JWT_SECRET=<generate-a-random-64-byte-secret>
JWT_ISSUER=quiztest-api
JWT_AUDIENCE=quiztest-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# Email verification
EMAIL_CODE_SECRET=<generate-an-independent-random-64-byte-secret>
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# Alibaba Cloud DirectMail SMTP
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_USER=no-reply@mail.example.com
SMTP_PASS=<smtp-password>
MAIL_FROM="AceMock <no-reply@mail.example.com>"

# HTTP test server example:
# API_RUNTIME_ENV=test
# FRONTEND_URL=http://8.149.140.115
# CORS_ORIGINS=http://8.149.140.115
# TRUST_PROXY=1
# REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_SAME_SITE=lax

# HTTPS production example:
# API_RUNTIME_ENV=prod
# FRONTEND_URL=https://acemock.cn
# CORS_ORIGINS=https://acemock.cn,https://www.acemock.cn
# TRUST_PROXY=1
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAME_SITE=lax
