# Runtime profile is mandatory: local and test support HTTP; prod requires HTTPS cookies.
# local: direct local development; test/prod: normally one trusted Nginx proxy hop.
# Deployment validation can load another file by setting API_ENV_FILE before starting Node.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/quiztestdemo"
API_RUNTIME_ENV=local
API_PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Access and refresh session. JWT_SECRET is mandatory in test and prod.
JWT_SECRET=<generate-a-random-64-byte-secret>
JWT_ISSUER=quiztest-api
JWT_AUDIENCE=quiztest-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# Email verification. EMAIL_CODE_SECRET is mandatory in test and prod.
EMAIL_CODE_SECRET=<generate-an-independent-random-64-byte-secret>
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# Website traffic analytics. Mandatory in test and prod; generate an independent random secret.
VISITOR_IP_HASH_SECRET=<generate-an-independent-random-64-byte-secret>

# Alibaba Cloud DirectMail SMTP. SMTP_USER, SMTP_PASS and MAIL_FROM are mandatory in test and prod.
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_USER=no-reply@mail.example.com
SMTP_PASS=<smtp-password>
MAIL_FROM="AceMock <no-reply@mail.example.com>"

# ChinaUMS C-scan-B aggregate QR payment. Test outbound calls can omit callback settings.
# A public HTTP callback is permitted for test notification verification; production requires HTTPS.
CHINAUMS_ENABLED=false
CHINAUMS_ENV=test
CHINAUMS_BASE_URL=https://test-api-open.chinaums.com
CHINAUMS_APP_ID=<developer-app-id>
CHINAUMS_APP_KEY=<developer-app-key>
CHINAUMS_MID=<15-character-merchant-id>
# Production guard: repeat the approved merchant ID so deployment fails if test/other merchant parameters are copied by mistake.
CHINAUMS_EXPECTED_MID=
CHINAUMS_TID=<8-character-terminal-id>
CHINAUMS_INST_MID=QRPAYDEFAULT
CHINAUMS_MSG_SRC_ID=<4-character-system-id>
CHINAUMS_COMMUNICATION_KEY=
CHINAUMS_NOTIFY_URL=
CHINAUMS_RETURN_URL=http://<public-ip>/
CHINAUMS_ORDER_DESCRIPTION="AceMock Membership"
CHINAUMS_TIMEOUT_MS=10000
CHINAUMS_ORDER_EXPIRE_MINUTES=15

# Optional comma-separated login email allowlist for controlled real-payment verification.
# Leave empty for normal public purchasing; enforcement is server-side.
PAYMENT_PURCHASE_ALLOWED_EMAILS=

# Payment lifecycle worker. A database lease prevents duplicate cycles across API instances.
# Local development defaults to disabled; test and production default to enabled.
PAYMENT_LIFECYCLE_ENABLED=false
PAYMENT_LIFECYCLE_POLL_INTERVAL_MS=60000
PAYMENT_LIFECYCLE_LEASE_MS=300000
PAYMENT_LIFECYCLE_BATCH_SIZE=20
PAYMENT_PENDING_QUERY_AGE_SECONDS=30
PAYMENT_REFUND_QUERY_AGE_SECONDS=30
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_HOUR=2
PAYMENT_RECONCILIATION_BATCH_SIZE=100

# HTTP test server example:
# API_RUNTIME_ENV=test
# FRONTEND_URL=https://test.example.invalid
# CORS_ORIGINS=https://test.example.invalid
# TRUST_PROXY=1
# REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_SAME_SITE=lax
# CHINAUMS_ENABLED=true
# CHINAUMS_ENV=test
# CHINAUMS_NOTIFY_URL=https://test.example.invalid/api/payment/notifications/chinaums

# HTTPS production example:
# API_RUNTIME_ENV=prod
# FRONTEND_URL=https://acemock.cn
# CORS_ORIGINS=https://acemock.cn
# TRUST_PROXY=1
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAME_SITE=lax
# CHINAUMS_ENABLED=true
# CHINAUMS_ENV=prod
# CHINAUMS_BASE_URL=https://api-mop.chinaums.com
# CHINAUMS_MID=898310100032223
# CHINAUMS_EXPECTED_MID=898310100032223
# CHINAUMS_NOTIFY_URL=https://acemock.cn/api/payment/notifications/chinaums
# CHINAUMS_RETURN_URL=https://acemock.cn/
