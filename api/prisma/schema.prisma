generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Paper {
  id             String   @id @default(uuid())
  title          String
  code           String?
  year           Int
  duration       Int
  totalQuestions Int      @default(0)
  paperType      String   @default("past")
  pdfUrl         String?
  status         String   @default("draft")
  questions      String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parseTasks  ParseTask[]
  examRecords ExamRecord[]
}

model ParseTask {
  id        String   @id @default(uuid())
  paperId   String
  status    String   @default("pending")
  progress  Int      @default(0)
  error     String?
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("student")
  paymentStatus  String   @default("free")
  diagnosticUsed Boolean  @default(false)
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  examRecords      ExamRecord[]
  diagnosticSession DiagnosticSession[]
}

model DiagnosticSession {
  id             String   @id @default(uuid())
  userId         String?
  answers        String
  totalQuestions Int
  correctCount   Int
  status         String   @default("anonymous")
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ExamRecord {
  id             String    @id @default(uuid())
  userId         String
  paperId        String
  totalQuestions Int       @default(0)
  correctCount   Int       @default(0)
  startedAt      DateTime
  submittedAt    DateTime?
  status         String    @default("in_progress")

  user    User           @relation(fields: [userId], references: [id])
  paper   Paper          @relation(fields: [paperId], references: [id])
  answers AnswerRecord[]
}

model AnswerRecord {
  id             String   @id @default(uuid())
  examRecordId   String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean  @default(false)
  answeredAt     DateTime?

  examRecord ExamRecord @relation(fields: [examRecordId], references: [id], onDelete: Cascade)
}

model SyllabusNode {
  id         String  @id @default(uuid())
  code       String                    // 学科编码，如 "112001"
  label      String                    // 节点名称
  examType   String                    // ESAT | TMUA
  parentCode String?                   // 父节点编码，null=根节点
  order      Int     @default(0)       // 同级排序
  createdAt  DateTime @default(now())

  @@unique([examType, code])
  @@index([examType])
  @@index([parentCode])
}

model RevenueCost {
  id                  String   @id @default(uuid())
  rechargeItem        String
  amount              Float
  operator            String
  occurredAt          DateTime
  reimbursementStatus String   @default("unreimbursed")
  remark              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([occurredAt])
}
