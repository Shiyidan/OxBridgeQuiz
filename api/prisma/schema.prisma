generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Paper {
  id             String   @id @default(uuid())
  title          String
  code           String?
  examType       String   @default("TMUA")
  year           Int
  duration       Int
  totalQuestions Int      @default(0)
  paperType      String   @default("realPaper")
  pdfUrl         String?
  status         String   @default("draft")
  questions      String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parseTasks  ParseTask[]
  examRecords ExamRecord[]
  questionsRel Question[]

  @@index([examType])
}

model Question {
  id              String   @id @default(uuid())
  paperId         String
  examType        String   @default("TMUA")
  number          Int
  title           String
  options         String   @default("[]")
  answer          String   @default("[]")
  subject         String?
  subjectCode     String?
  questionType    String?
  difficulty      String?
  topic           String?
  topicCode       String?
  knowledgePoints String   @default("[]")
  syllabusPoints  String   @default("[]")
  meta            String   @default("{}")
  createdAt       DateTime @default(now())

  paper         Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  answerRecords AnswerRecord[]

  @@index([paperId])
  @@index([examType])
  @@index([subjectCode])
  @@index([number])
}

model ParseTask {
  id        String   @id @default(uuid())
  paperId   String
  status    String   @default("pending")
  progress  Int      @default(0)
  error     String?
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("student")
  paymentStatus  String   @default("free")
  diagnosticUsed Boolean  @default(false)
  avatar         String?
  examPreferences String   @default("[]")  // JSON: [{ examType, subjects }]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  examRecords      ExamRecord[]
  diagnosticSession DiagnosticSession[]
  memberships      UserMembership[]
}

model DiagnosticSession {
  id             String   @id @default(uuid())
  userId         String?
  examType       String   @default("TMUA")
  answers        String
  totalQuestions Int
  correctCount   Int
  status         String   @default("anonymous")
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([examType])
}

model ExamRecord {
  id             String    @id @default(uuid())
  userId         String
  paperId        String
  examType       String    @default("TMUA")
  totalQuestions Int       @default(0)
  correctCount   Int       @default(0)
  startedAt      DateTime
  submittedAt    DateTime?
  status         String    @default("in_progress")

  user    User           @relation(fields: [userId], references: [id])
  paper   Paper          @relation(fields: [paperId], references: [id])
  answers AnswerRecord[]

  @@index([userId, examType])
  @@index([examType])
}

model AnswerRecord {
  id              String   @id @default(uuid())
  examRecordId    String
  questionId      String
  selectedAnswer  String?
  isCorrect       Boolean  @default(false)
  durationSeconds Int      @default(0)
  answeredAt      DateTime?

  examRecord ExamRecord @relation(fields: [examRecordId], references: [id], onDelete: Cascade)
  question   Question  @relation(fields: [questionId], references: [id])
}

model SyllabusNode {
  id         String  @id @default(uuid())
  code       String                    // 学科编码，如 "112001"
  label      String                    // 节点名称
  examType   String                    // ESAT | TMUA | STEP
  parentCode String?                   // 父节点编码，null=根节点
  order      Int     @default(0)       // 同级排序
  createdAt  DateTime @default(now())

  @@unique([examType, code])
  @@index([examType])
  @@index([parentCode])
}

model Syllabus {
  id         String   @id @default(uuid())
  name       String
  examType   String
  sourceJson String
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([examType])
  @@index([isActive])
}

model RevenueCost {
  id                  String   @id @default(uuid())
  rechargeItem        String
  amount              Float
  operator            String
  occurredAt          DateTime
  reimbursementStatus String   @default("unreimbursed")
  remark              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([occurredAt])
}

model MembershipPlan {
  id           String   @id @default(uuid())
  examType     String
  plan         String
  priceCents   Int      @default(0)
  durationDays Int      @default(30)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([examType, plan])
  @@index([examType])
}

model UserMembership {
  id        String   @id @default(uuid())
  userId    String
  examType  String
  plan      String
  status    String   @default("active")
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examType])
  @@index([userId, examType, status])
}

model EntitlementConfig {
  id                String   @id @default(uuid())
  examType          String   @unique
  diagnosticLimit   Int      @default(2)
  questionBankLimit Int      @default(100)
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
