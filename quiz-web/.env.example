# Vite chooses the API target at build time.
VITE_API_ENV=local

# Optional override. Leave empty in production when Nginx proxies /api on the same origin.
VITE_API_BASE=http://localhost:3001

# HTTP test server example:
# VITE_API_ENV=test
# VITE_API_BASE=http://8.149.140.115

# HTTPS production, same-origin /api example:
# VITE_API_ENV=prod
# VITE_API_BASE=
